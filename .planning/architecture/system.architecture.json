  "cards": [
    {
      "dot": "cyan",
      "title": "Superfície pública única",
      "items": [
        "Frontend e API usam https://inteia.com.br/mirofish",
        "Portas internas não são URLs de produto",
        "Vercel permanece alternativa histórica"
      ]
    },
    {
      "dot": "rose",
      "title": "Helena sob controle",
      "items": [
        "Token interno nunca entra no bundle ou armazenamento local",
        "Mutação exige confirmação e ticket de uso único",
        "Nenhum shell, arquivo livre ou HTTP arbitrário"
      ]
    },
    {
      "dot": "emerald",
      "title": "Entrega auditável",
      "items": [
        "Simulação, trace e fontes atravessam gates",
        "Estados e eventos são persistidos atomicamente",
        "Backup e rollback antecedem cada cutover"
      ]
    }
