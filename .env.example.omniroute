# Mirofish INTEIA — template com combos OmniRoute especializados por tarefa
# Copie para .env e substitua <SUA_KEY_NOVA> quando gerar key no painel.

APP_NAME=MiroFish-Inteia
APP_CODE=mirofish-inteia

# ===== OmniRoute (gateway INTEIA) =====
OMNIROUTE_URL=https://omniroute.srv1354997.hstgr.cloud
OMNIROUTE_API_KEY=<SUA_KEY_NOVA>

LLM_API_KEY=<SUA_KEY_NOVA>
LLM_BASE_URL=https://omniroute.srv1354997.hstgr.cloud/v1
LLM_MODEL_NAME=openai/gpt-5.6-luna
LLM_AGENT_MODEL=openai/gpt-5.6-luna
LLM_PREMIUM_MODEL=openai/gpt-5.6-luna
LLM_HELENA_MODEL=openai/gpt-5.6-luna
LUNA_REASONING_EFFORT=low
LLM_TIMEOUT_SECONDS=120
LLM_MAX_RETRIES=3

# Aliases antigos podem continuar sendo resolvidos para Luna em ambientes
# que ainda os armazenem em projetos ou configuracoes anteriores.
LLM_MODEL_ALIASES={"helena-premium":"openai/gpt-5.6-luna","sonnet-tasks":"openai/gpt-5.6-luna","opus-tasks":"openai/gpt-5.6-luna","haiku-tasks":"openai/gpt-5.6-luna"}

# ===== Graphiti / Neo4j =====
GRAPHITI_BASE_URL=http://localhost:8003
GRAPHITI_TIMEOUT=180
GRAPHITI_MODEL=openai/gpt-5.6-luna
NEO4J_PASSWORD=mirofish2026

# ===== Zep legacy opcional =====
# Mantido para compatibilidade com snapshots antigos; prefira Graphiti.
ZEP_BASE_URL=
ZEP_API_KEY=
ZEP_MODE=disabled
ZEP_REQUIRED=false

# ===== Apify enrichment opcional =====
APIFY_API_TOKEN=<SUA_APIFY_TOKEN>
APIFY_ENRICH_TIMEOUT_SECONDS=45
COLMEIA_SCRIPTS_PATH=

# ===== Supabase opcional =====
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=<SUA_SUPABASE_ANON_KEY>
SUPABASE_SERVICE_ROLE_KEY=<SUA_SUPABASE_SERVICE_ROLE_KEY>

# ===== Dados locais =====
MIROFISH_DATA_DIR=data

# ===== Auth =====
INTERNAL_API_TOKEN=mirofish-inteia-local-2026

# ===== Flask =====
FLASK_DEBUG=False
FLASK_HOST=0.0.0.0
FLASK_PORT=5001
