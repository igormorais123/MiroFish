# ===== LLM =====
OMNIROUTE_URL=http://omniroute-inteia:20128
OMNIROUTE_API_KEY=your_omniroute_api_key_here
# Chave interna do OmniRoute. O upstream codex/* usa OAuth da assinatura
# ChatGPT/Codex; nao preencha OPENAI_API_KEY para ativar esta rota.
LLM_API_KEY=your_omniroute_api_key_here
LLM_BASE_URL=http://omniroute-inteia:20128/v1
LLM_MODEL_NAME=codex/gpt-5.6-luna
LLM_AGENT_MODEL=codex/gpt-5.6-luna
LLM_PREMIUM_MODEL=codex/gpt-5.6-luna
LLM_HELENA_MODEL=codex/gpt-5.6-luna
LUNA_REASONING_EFFORT=low
LLM_TIMEOUT_SECONDS=120
LLM_MAX_RETRIES=3
REPORT_SECTION_WORKERS=1

# ===== Neo4j (usado pelo Graphiti) =====
NEO4J_PASSWORD=mirofish2026

# ===== Graphiti =====
# Modelo que o Graphiti usa internamente para extrair entidades
GRAPHITI_BASE_URL=http://graphiti:8000
GRAPHITI_TIMEOUT=180
GRAPHITI_REQUIRED=false
MIROFISH_UPLOADS_DIR=/opt/mirofish/backend/uploads
GRAPHITI_MODEL=codex/gpt-5.6-luna
EMBEDDER_BASE_URL=http://ollama-inteia:11434/v1
EMBEDDER_API_KEY=ollama
EMBEDDER_MODEL_NAME=nomic-embed-text
EMBEDDER_DIM=768
GUNICORN_WORKERS=1
GUNICORN_THREADS=4

# ===== Zep legacy opcional =====
ZEP_BASE_URL=
ZEP_API_KEY=
ZEP_MODE=disabled
ZEP_REQUIRED=false

# ===== Auth =====
INTERNAL_API_TOKEN=generate_a_secure_token_here
SECRET_KEY=generate_a_random_64_hex_secret_here
