{
  "$id": "https://mirofish.local/schemas/vox/claim-evidence.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "ids30": {"type": "array", "minItems": 30, "maxItems": 10000, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "distribution": {"type": "array", "minItems": 1, "maxItems": 10000, "items": {"type": "number", "minimum": 0, "maximum": 1}},
    "runRef": {
      "type": "object", "additionalProperties": false,
      "required": ["run_id", "seed", "artifact_path", "artifact_sha256"],
      "properties": {
        "run_id": {"type": "string", "minLength": 1}, "seed": {"type": "integer"},
        "artifact_path": {"type": "string", "minLength": 1}, "artifact_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "subgroup": {
      "type": "object", "additionalProperties": false,
      "required": ["predicted_n", "sample_ids", "observed_distribution", "predicted_distribution", "sample_sha256"],
      "properties": {
        "predicted_n": {"type": "integer", "minimum": 30}, "sample_ids": {"$ref": "#/$defs/ids30"},
        "observed_distribution": {"$ref": "#/$defs/distribution"}, "predicted_distribution": {"$ref": "#/$defs/distribution"},
        "sample_sha256": {"$ref": "#/$defs/sha256"}
      }
    }
  },
  "title": "Vox materialized C2-C4 claim evidence bundle",
  "type": "object", "additionalProperties": false,
  "required": ["schema", "version", "generated_at", "binding", "evaluation", "stability", "prospective"],
  "properties": {
    "schema": {"const": "mirofish.vox.claim_evidence_bundle.v1"}, "version": {"const": 1},
    "generated_at": {"type": "string", "format": "date-time"},
    "binding": {
      "type": "object", "additionalProperties": false,
      "required": ["report_id", "simulation_id", "run_id", "config_sha256", "input_sha256", "baseline_snapshot_sha256"],
      "properties": {
        "report_id": {"type": "string", "minLength": 1}, "simulation_id": {"type": "string", "minLength": 1},
        "run_id": {"type": "string", "minLength": 1}, "config_sha256": {"$ref": "#/$defs/sha256"},
        "input_sha256": {"$ref": "#/$defs/sha256"}, "baseline_snapshot_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "evaluation": {
      "type": "object", "additionalProperties": false,
      "required": ["evaluation_id", "variable_id", "variable_label", "categories", "evaluated_at", "sample_ids", "observed_distribution", "predicted_distribution", "sample_sha256"],
      "properties": {
        "evaluation_id": {"type": "string", "minLength": 1}, "variable_id": {"type": "string", "minLength": 1},
        "variable_label": {"type": "string", "minLength": 1},
        "categories": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "evaluated_at": {"type": "string", "format": "date-time"}, "sample_ids": {"$ref": "#/$defs/ids30"},
        "observed_distribution": {"$ref": "#/$defs/distribution"}, "predicted_distribution": {"$ref": "#/$defs/distribution"},
        "sample_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "stability": {
      "oneOf": [
        {"type": "null"},
        {"type": "object", "additionalProperties": false, "required": ["runs", "subgroups"], "properties": {
          "runs": {"type": "array", "minItems": 3, "maxItems": 32, "items": {"$ref": "#/$defs/runRef"}},
          "subgroups": {"type": "object", "minProperties": 2, "maxProperties": 256, "additionalProperties": {"$ref": "#/$defs/subgroup"}}
        }}
      ]
    },
    "prospective": {
      "oneOf": [
        {"type": "null"},
        {"type": "object", "additionalProperties": false,
          "required": ["status", "mode", "preregistration_id", "preregistration_receipt_path", "preregistration_receipt_sha256", "training_cutoff", "evaluated_at", "heldout_times", "report_id", "simulation_id", "run_id", "config_sha256", "input_sha256", "baseline_snapshot_sha256", "training_ids", "heldout_ids", "observed_outcomes"],
          "properties": {
            "status": {"const": "measured"}, "mode": {"const": "prospective_out_of_sample"},
            "preregistration_id": {"type": "string", "minLength": 1}, "preregistration_receipt_path": {"type": "string", "minLength": 1},
            "preregistration_receipt_sha256": {"$ref": "#/$defs/sha256"}, "training_cutoff": {"type": "string", "format": "date-time"},
            "evaluated_at": {"type": "string", "format": "date-time"}, "heldout_times": {"type": "array", "minItems": 30, "maxItems": 10000, "items": {"type": "string", "format": "date-time"}},
            "report_id": {"type": "string", "minLength": 1}, "simulation_id": {"type": "string", "minLength": 1}, "run_id": {"type": "string", "minLength": 1},
            "config_sha256": {"$ref": "#/$defs/sha256"}, "input_sha256": {"$ref": "#/$defs/sha256"}, "baseline_snapshot_sha256": {"$ref": "#/$defs/sha256"},
            "training_ids": {"type": "array", "minItems": 1, "maxItems": 10000, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
            "heldout_ids": {"$ref": "#/$defs/ids30"},
            "observed_outcomes": {"type": "array", "minItems": 30, "maxItems": 10000, "items": {
              "type": "object", "additionalProperties": false, "required": ["id", "value"],
              "properties": {"id": {"type": "string", "minLength": 1}, "value": {"type": "string", "minLength": 1}}
            }}
          }
        }
      ]
    }
  }
}
