{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "mirofish.vox.replicator-input.schema.json",
  "title": "Vox Science replicator input",
  "type": "array",
  "maxItems": 32,
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": ["name", "response_distribution"],
    "properties": {
      "name": {"type": "string", "minLength": 1, "maxLength": 128},
      "version": {"type": "string", "maxLength": 128},
      "temperature": {"type": "number", "minimum": 0, "maximum": 2},
      "seed": {"type": "integer"},
      "response_distribution": {
        "type": "array",
        "minItems": 1,
        "maxItems": 256,
        "items": {"type": "number"}
      },
      "primary_distribution": {
        "type": "array",
        "minItems": 1,
        "maxItems": 256,
        "items": {"type": "number"}
      },
      "response_text": {"type": "string", "maxLength": 4096}
    }
  }
}
