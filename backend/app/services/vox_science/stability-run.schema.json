{
  "$id": "https://mirofish.local/schemas/vox/stability-run.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Vox independently materialized stability run",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "version", "generated_at", "report_id", "simulation_id", "run_id", "seed", "input_sha256", "config_sha256", "baseline_snapshot_sha256", "variable_id", "variable_label", "categories", "sample_ids", "distribution", "sample_sha256"],
  "properties": {
    "schema": {"const": "mirofish.vox.stability_run.v1"}, "version": {"const": 1},
    "generated_at": {"type": "string", "format": "date-time"},
    "report_id": {"type": "string", "minLength": 1}, "simulation_id": {"type": "string", "minLength": 1},
    "run_id": {"type": "string", "minLength": 1}, "seed": {"type": "integer"},
    "input_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "config_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "baseline_snapshot_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "variable_id": {"type": "string", "minLength": 1}, "variable_label": {"type": "string", "minLength": 1},
    "categories": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "sample_ids": {"type": "array", "minItems": 30, "maxItems": 10000, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "distribution": {"type": "array", "minItems": 1, "maxItems": 10000, "items": {"type": "number", "minimum": 0, "maximum": 1}},
    "sample_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
