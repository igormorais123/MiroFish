{
  "$id": "https://mirofish.local/schemas/vox/preregistered-forecast.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Vox preregistered per-ID forecast",
  "type": "object", "additionalProperties": false,
  "required": ["schema", "version", "generated_at", "training_cutoff", "report_id", "simulation_id", "run_id", "config_sha256", "input_sha256", "baseline_snapshot_sha256", "variable_id", "variable_label", "unit", "categories", "heldout_predictions"],
  "properties": {
    "schema": {"const": "mirofish.vox.preregistered_forecast.v1"}, "version": {"const": 1},
    "generated_at": {"type": "string", "format": "date-time"}, "training_cutoff": {"type": "string", "format": "date-time"},
    "report_id": {"type": "string", "minLength": 1}, "simulation_id": {"type": "string", "minLength": 1}, "run_id": {"type": "string", "minLength": 1},
    "config_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "input_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "baseline_snapshot_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "variable_id": {"type": "string", "minLength": 1}, "variable_label": {"type": "string", "minLength": 1}, "unit": {"type": "string", "minLength": 1},
    "categories": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "heldout_predictions": {"type": "array", "minItems": 30, "maxItems": 10000, "items": {
      "type": "object", "additionalProperties": false, "required": ["id", "distribution"],
      "properties": {"id": {"type": "string", "minLength": 1}, "distribution": {"type": "array", "minItems": 1, "items": {"type": "number", "minimum": 0, "maximum": 1}}}
    }}
  }
}
